{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tenhou-se",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "se.nivalis.is",
      "custom_domain": true
    }
  ]
}
